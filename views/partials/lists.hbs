{{!Dynamisk liste til oversigter}}
<ul class="list">
    {{#each items}}
    <li class="list-item">
        <div class="list-content">
            {{#each ../fields}}
            <div class="list-field">
                {{lookup ../this this}}
            </div>
            {{/each}}
        </div>

        <div class="list-actions">
            {{!-- Rediger fra liste --}}
            <button>
                <a href="{{../editUrl}}/{{this.id}}"
                class="action-icon edit"
                title="Rediger">
                <i data-lucide="square-pen"></i>
                </a>
            </button>
            
            <div class="separator"></div>

            {{!-- Slet fra liste --}}  
            <button onclick="deleteItem('{{../deleteUrl}}', {{this.id}})" class="action-icon delete" title="Slet">
                <i data-lucide="trash"></i>
            </button>
        </div>
    </li>
{{/each}}
</ul>
<script>
  function deleteItem(deleteUrl, id) {
    if (confirm('Er du sikker på du vil slette?')) {
      fetch(`${deleteUrl}/${id}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(response => {
        if (response.ok) {
          location.reload();
        } else {
          alert('Fejl ved sletning');
        }
      })
      .catch(error => {
        console.error('Fejl:', error);
        alert('Fejl ved sletning');
      });
    }
  }
</script>
