{{!Dynamisk liste til oversigter}}
<input 
type="text"
id="searchBar"
placeholder="Søg"
class="search-bar"
>

<ul class="list">
    {{#each items}}
    <li class="list-item">
        <div class="list-content">
            {{#each ../fields}}
            <div class="list-field">
                {{lookup ../this this}}
            </div>
            {{/each}}
        </div>

        <div class="list-actions">
            {{!-- Rediger fra liste --}}
            <button>
                <a href="{{../editUrl}}/{{this.id}}"
                class="action-icon edit"
                title="Rediger">
                <i data-lucide="square-pen"></i>
                </a>
            </button>
            
            <div class="separator"></div>

            {{!-- Slet fra liste --}}  
            <button onclick="deleteItem('{{../deleteUrl}}', {{this.id}})" class="action-icon delete" title="Slet">
                <i data-lucide="trash"></i>
            </button>
        </div>
    </li>
{{/each}}
</ul>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const searchBar = document.getElementById("searchBar");
  const lists = document.querySelectorAll(".list");

  if (!searchBar || lists.length === 0) return;

  searchBar.addEventListener("keyup", function() {
    const filter = this.value.toLowerCase();

    lists.forEach(list => {
      const listItems = list.querySelectorAll(".list-item");

      listItems.forEach(item => {
        const text = item.innerText.toLowerCase();
        item.style.display = text.includes(filter) ? "" : "none";
      });
    });
  });
});
</script>

<script src="/js/delete.js"></script>