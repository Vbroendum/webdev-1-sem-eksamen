{{!Dynamisk liste til oversigter}}
<ul class="list">
    {{#each items}}
    <li class="list-item">
        <div class="list-content">
            {{#each ../fields}}
            <div class="list-field">
                {{lookup ../this this}}
            </div>
            {{/each}}
        </div>

        <div class="list-actions">
            {{!-- Rediger fra liste --}}
            <button>
                <a href="{{../editUrl}}/{{this.id}}"
                class="action-icon edit"
                title="Rediger">
                Rediger
                </a>
            </button>
            
            <div class="separator"></div>

            {{!-- Slet fra liste --}}  
            <button>
                <a href="{{../deleteUrl}}/{{this.id}}/delete"
                onclick="return confirm('Er du sikker på du vil slette?')">
                Slet
                </a>
            </button>
        </div>
    </li>
{{/each}}
</ul>

