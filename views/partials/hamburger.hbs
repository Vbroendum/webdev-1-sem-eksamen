{{#if currentUser}}
<div class="topbar">
    <button id="back-button" class="back-button">
        <i data-lucide="arrow-left"></i>
    </button>

    <h1 class="title">{{title}}</h1>

    <button id="hamburger" class="hamburger">
        <i data-lucide="menu" class="icon-menu"></i>
        <i data-lucide="x" class="icon-close"></i>
    </button>
</div>

<aside class="sidebar">
    <nav>
        <ul>
            {{! admin menupunkter}}
            {{#if (eq currentUser.role_id 1)}}
                <p class="menu-category">Oversigt</p>
                    <li><i data-lucide="house"></i><a href="/dashboard">Dashboard</a></li>
                    <li><i data-lucide="user"></i><a href="/users">Brugere</a></li>
                    <li><i data-lucide="fuel"></i><a href="/stations">Stationer</a></li>
                    <li><i data-lucide="shopping-cart"></i><a href="/products">Produkter</a></li>
                    <li><i data-lucide="layout-list"></i><a href="/orders">Ordrer</a></li>
                    <li><i data-lucide="building-2"></i><a href="/companies">Virksomheder</a></li>
                    <li><i data-lucide="history"></i><a href="/history">Historik</a></li>

                 <p class="menu-category">Genveje</p>
                    <li class="submenu-toggle">
                        <div class="submenu-header">
                            <i data-lucide="plus"></i>
                            <span>Opret</span>
                            <i data-lucide="chevron-down" class="chevron"></i>
                        </div>
                    </li>

                    <li class="submenu-wrapper">
                        <ul class="submenu">
                            <li><a href="/users/new-user">Opret bruger</a></li>
                            <li><a href="/stations/new-station">Opret station</a></li>
                            <li><a href="/products/new-product">Opret produkt</a></li>
                            <li><a href="/companies/new-company">Opret virksomhed</a></li>
                        </ul>
                    </li>
            {{/if}}
            {{! bruger menupunkter}}
            {{#if (eq currentUser.role_id 2)}}

                <p class="menu-category">Opgaver</p>
                    <li>
                        <i data-lucide="check-square"></i>
                        <a href="/serviceplan">Serviceplan</a>
                    </li>
                    <li>
                        <i data-lucide="history"></i>
                        <a href="/history">Historik</a>
                    </li>
            {{/if}}
        </ul>
    </nav>
        {{! logud knap }}
        <div class="logout-container">
            <button class="logout-btn" onclick="logout()"><i data-lucide="log-out" class="logout-icon"></i>Log ud</button>
        </div>
</aside>
{{/if}}

