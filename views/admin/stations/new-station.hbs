<form class="new-station input-form" method="POST" action="/stations">

    <div class="form-group">
        <label>Station</label>
        <input type="text" name="station_name" placeholder="Indtast station" required>
    </div>

    <div class="form-group">
        <label>Adresse</label>
        <input type="text" name="station_address" placeholder="Indtast adresse" required>
    </div>

    <div class="form-group">
        <label>Postnummer</label>
        <input type="text" name="station_postal_code" placeholder="Indtast postnummer" required>
    </div>

    <div class="form-group">
        <label>Vælg firma</label>
        <select name="company_id" required>
            <option value="">Vælg firma</option>
            {{#each companies}}
                <option value="{{this.id}}">
                    {{this.name}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" name="station_has_bay">
            Station har forplads
        </label>
    </div>

    <button class="test-btn new-station-button" type="submit">
        Gem ny station
    </button>

</form>
