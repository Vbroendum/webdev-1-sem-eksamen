<form class="edit-station input-form"
      method="POST"
      action="/stations/{{station.id}}/edit-station">

    <div class="form-group">
        <label for="station_name">Station</label>
        <input type="text"
               id="station_name"
               name="station_name"
               value="{{station.station_name}}"
               required>
    </div>

    <div class="form-group">
        <label for="station_address">Adresse</label>
        <input type="text"
               id="station_address"
               name="station_address"
               value="{{station.station_address}}"
               required>
    </div>

    <div class="form-group">
        <label for="station_postal_code">Postnummer</label>
        <input type="text"
               id="station_postal_code"
               name="station_postal_code"
               value="{{station.station_postal_code}}"
               required>
    </div>

    <div class="form-group">
        <label for="company_id">Vælg firma</label>
<select name="company_id">
  {{#each companies}}
    <option value="{{this.id}}">
      {{this.name}}
    </option>
  {{/each}}
</select>

    </div>

  <div class="form-group">
      <label>Forplads</label>

      <div class="checkbox-group">
          <label class="checkbox-label">
              <input type="checkbox"
                    name="station_has_bay"
                    {{#if station.station_has_bay}}checked{{/if}}>
              <span class="checkbox-text">
                  Station har forplads
              </span>
          </label>
      </div>
  </div>

    <div class="submit-row">
        <button class="submit-btn" type="submit">
            Gem ændringer
        </button>
    </div>

</form>
