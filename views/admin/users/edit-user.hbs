<form action="/users/{{user.id}}/edit-user" method="post" class="input-form">
    
    <div class="form-group">
        <label for="firstname">Fornavn</label>
        <input type="text" name="first_name" value="{{user.first_name}}" required> 
    </div>

    <div class="form-group">
        <label for="lastname">Efternavn</label>
        <input type="text" name="last_name" value="{{user.last_name}}" required> 
    </div>

    <div class="form-group">
        <label for="email">Email</label>
        <input type="text" name="user_email" value="{{user.user_email}}" required>
    </div>
    <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="user_password">
    </div>

    <div class="form-group">
        <label for="role">Rolle</label>
        <select name="role_id">
            <option value="1">Admin</option>
            <option value="2">Rengøringspersonale</option>
        </select>
    </div>
    <div class="form-group">
        <label>Vælg stationer</label>
        <div class="checkbox-group">
            {{#each stations}}
                <label class="checkbox-label">
                    <input type="checkbox" name="station_ids[]" value="{{this.id}}" 
                        {{#if (includes ../assignedStationIds this.id)}}checked{{/if}}>
                    {{this.station_name}}, {{this.station_address}}
                </label>
            {{/each}}
        </div>
    </div>

    <button type="submit" class="submit-btn">Opdater bruger</button>

</form>