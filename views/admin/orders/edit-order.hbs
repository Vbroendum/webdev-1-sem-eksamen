<form action="/orders/{{order.id}}/edit" method="POST" class="input-form">
    
    <div class="form-group">
        <label for="deadline">Deadline</label>
        <input type="date" name="deadline" id="order-deadline" value="{{formattedOrder.serviceplan_expired_at}}" required>
    </div>

    <div class="form-group">
        <label for="order-station">Station</label>
        <select name="stationer" id="order-stations" required>
            {{#each stations}}
                <option value="{{this.id}}" {{#if (eq this.id ../order.station_id)}}selected{{/if}}>
                    {{this.station_name}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label for="done_at">Udført dato (valgfri)</label>
        <input type="date" name="done_at" id="order-done" value="{{order.serviceplan_done_at}}">
    </div>

    <div class="form-group">
        <label for="order-user">Tildel bruger (valgfri)</label>
        <select name="user_id" id="order-user">
            <option value="">-- Ingen bruger --</option>
            {{#each users}}
                <option value="{{this.id}}" {{#if (eq this.id ../order.user_id)}}selected{{/if}}>
                    {{this.first_name}} {{this.last_name}}
                </option>
            {{/each}}
        </select>
    </div>

            <div class="submit-row">
    <button class="submit-btn" type="submit">
        Gem ændringer
    </button>
</form>