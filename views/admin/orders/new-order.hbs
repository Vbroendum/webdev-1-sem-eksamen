<form action="/orders" method="POST"class="input-form">
    <div class="form-group">
        <label for="deadline">Deadline</label>
        <input type="date" name="deadline" id="order-deadline" required placeholder="Vælg dato">
    </div>

    <div class="form-group">
        <label for="order-station">Station</label>
        <select name="stationer" id="order-stations">
            {{#each stations}}
                <option value="{{this.id}}">{{this.station_name}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label for="order-user">Tildel bruger (valgfri)</label>
        <select name="user_id" id="order-user">
            <option value="">-- Ingen bruger --</option>
            {{#each users}}
                <option value="{{this.id}}">{{this.first_name}} {{this.last_name}}</option>
            {{/each}}
        </select>
    </div>

    <button type="submit" class="submit-btn">Opret rengøringsordre</button>
</form>