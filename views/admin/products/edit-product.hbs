
<form action="/products/edit/{{product.id}}" method="POST">
    <div class="form-group">
        <label for="products_name">Produktnavn</label>
        <input type="text" name="products_name" value="{{product.products_name}}" required>
    </div>

    <div class="form-group">
        <label for="unit_id">Enhed</label>
        <input type="number" name="unit_id" value="{{product.unit_id}}" required>
    </div>

    <button type="submit" class="submit-btn">Opdater produkt</button>