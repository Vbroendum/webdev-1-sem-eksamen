
<form action="/products/edit/{{product.id}}" method="POST" class="input-form">
    <div class="form-group">
        <label for="products_name">Produktnavn</label>
        <input type="text" name="products_name" value="{{product.products_name}}" required>
    </div>

    <div class="form-group">
        <label for="unit_id">Enhed (Mængdeindikator)</label>
        <select name="unit_id" required>
            <option value="">-- Vælg enhed --</option>
            {{#each units}}
                <option value="{{this.id}}" {{#if (eq this.id product.unit_id)}}selected{{/if}}>{{this.unit}} ({{this.short_unit}})</option>
            {{/each}}
        </select>
    </div>

        <div class="submit-row">
    <button class="submit-btn" type="submit">
        Gem ændringer
    </button>
    </div>
</form>