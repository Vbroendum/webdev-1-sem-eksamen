
<form action="/products/create" method="POST">
    <div class="form-group">
        <label for="products_name">Produktnavn</label>
        <input type="text" name="products_name" required placeholder="Produktnavn">
    </div>

    <div class="form-group">
        <label for="unit_id">Enhed (Mængdeindikator)</label>
        <select name="unit_id" required>
            <option value="">-- Vælg enhed --</option>
            {{#each units}}
                <option value="{{this.id}}">{{this.unit}} ({{this.short_unit}})</option>
            {{/each}}
        </select>
    </div>

    <button type="submit" class="submit-btn">Opret produkt</button>
</form>