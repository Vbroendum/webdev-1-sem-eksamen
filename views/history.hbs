<ul class="list">
    {{#each history}}
        <li class="list-item history-row">
            <div class="history-thumb">
                {{#if images.length}}
                    <img src="{{images.[0].filepath}}" alt="thumbnail">
                {{else}}
                    <div class="no-image">Ingen</div>
                {{/if}}
            </div>

            <div class="history-text">
                <div class="history-title">{{station.station_name}}</div>
                <div class="history-date">Udført: {{serviceplan_done_at}}</div>

                {{#if (eq ../user.role_id 1)}}
                    <div class="history-user">Af: {{user.first_name}} {{user.last_name}}</div>
                {{/if}}
            </div>
        </li>
    {{/each}}
</ul>

