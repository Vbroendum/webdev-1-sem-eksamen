<h1>Historik</h1>

{{#each history}}
<div class="history-item">

    {{!-- Hvis der findes billeder, vis det første --}}
    {{#if images.length}}
        <img src="{{images.[0].filepath}}" class="history-img" alt="Billede">
    {{else}}
        <p>Ingen billeder</p>
    {{/if}}

    <h2>{{station.station_name}}</h2>

    <p><strong>Udført:</strong> {{serviceplan_done_at}}</p>

    {{!-- Kun admin ser udført af --}}
    {{#if (eq ../session.user.role_id 1)}}
        <p><strong>Udført af:</strong> {{user.first_name}} {{user.last_name}}</p>
    {{/if}}

</div>
{{/each}}

