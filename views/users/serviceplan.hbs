{{#if serviceplans.length}}
<div class="task-grid">
    {{#each serviceplans}}
        <div class="task-card">
            <div class="task-header">
                <div>
                    <h3 class="task-title">{{station.station_name}}</h3>
                    <p class="task-address">{{station.station_address}}</p> 
                </div>
            </div>

        <div class="serviceplan-actions {{#if user_id}}has-cancel{{/if}}">
            {{#if user_id}}
                <a href="/serviceplan/{{id}}" class="btn btn-primary">Udfyld opgave</a>

                <form action="/serviceplan/cancel/{{id}}" method="POST">
                    <button class="btn btn-danger" type="submit">Annuller</button>
                </form>
            {{else}}
                <form action="/serviceplan/accept/{{id}}" method="POST">
                    <button class="btn btn-primary full-width" type="submit">Accepter</button>
                </form>
            {{/if}}
        </div>
    {{/each}}
</div>

{{else}}
    <p>Du har ingen opgaver endnu.</p>
{{/if}}

<script src="/js/serviceplan.js"></script>