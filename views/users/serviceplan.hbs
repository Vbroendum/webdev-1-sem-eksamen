<div class="opgave">
{{#each stations}}
  <h2>{{station_name}}</h2>
  {{#each serviceplans}}
      {{#if accepted_at}}
          <a href="/serviceplan/{{id}}" class="btn">Udfyld opgave</a>
      {{else}}
        <form action="/serviceplan/accept/{{id}}" method="POST">
            <button type="submit" value="Accepter">Accepter</button>
        </form>
      {{/if}}
    </div>
  {{/each}}
{{/each}}


